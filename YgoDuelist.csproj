<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>packages\**</DefaultItemExcludes>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <GodotPath>C:\megadot\MegaDot_v4.5.1-stable_mono_win64.exe</GodotPath>
        <SteamLibraryPath>C:\SteamLibrary\steamapps</SteamLibraryPath>
        <Sts2Path>$(SteamLibraryPath)\common\Slay the Spire 2</Sts2Path>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Disable architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(Sts2Path)\data_sts2_windows_x86_64\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2Path)\data_sts2_windows_x86_64\sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.0.9" PrivateAssets="All" />
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*" />
        <AdditionalFiles Include="YgoDuelist\localization\**\*.json" />
    </ItemGroup>

    <PropertyGroup>
        <BaseLibPinnedVersion>3.0.9</BaseLibPinnedVersion>
        <BaseLibPackageRoot>packages\alchyr.sts2.baselib\$(BaseLibPinnedVersion)</BaseLibPackageRoot>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="YgoDuelist\**" />
        <Compile Remove="materials\**" />
        <Compile Remove="shaders\**" />
        <Compile Remove="images\**" />
        <EmbeddedResource Remove="YgoDuelist\**" />
        <EmbeddedResource Remove="materials\**" />
        <EmbeddedResource Remove="shaders\**" />
        <EmbeddedResource Remove="images\**" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".gitignore" />
        <None Include="YgoDuelist.json" />
        <None Include="project.godot" />
        <None Include="YgoDuelist\**" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="YgoDuelistCode\Cards\Monster\Todo\Effect\" />
        <Folder Include="YgoDuelistCode\Cards\Monster\Todo\Fusion\" />
        <Folder Include="YgoDuelistCode\Cards\Monster\Todo\Normal\" />
        <Folder Include="YgoDuelistCode\Cards\Monster\Todo\Ritual\" />
        <Folder Include="YgoDuelistCode\Cards\Spell\Todo\Continuos\" />
        <Folder Include="YgoDuelistCode\Cards\Spell\Todo\Equip\" />
        <Folder Include="YgoDuelistCode\Cards\Spell\Todo\Field\" />
        <Folder Include="YgoDuelistCode\Cards\Spell\Todo\Normal\" />
        <Folder Include="YgoDuelistCode\Cards\Trap\Todo\Continuos\" />
        <Folder Include="YgoDuelistCode\Cards\Trap\Todo\Linked\" />
        <Folder Include="YgoDuelistCode\Cards\Trap\Todo\Normal\" />
        <Folder Include="YgoDuelist\images\card_portraits\big\" />
        <Folder Include="YgoDuelist\images\powers\big\" />
        <Folder Include="YgoDuelist\images\relics\big\" />
    </ItemGroup>

    <!-- dotnet build /p:SkipDeployToMods=true when SlayTheSpire2.exe locks YgoDuelist.dll -->
    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent" Condition="'$(SkipDeployToMods)' != 'true'">
        <Message Text="Copying .dll and manifest to mods folder." Importance="high" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Path)\mods\$(MSBuildProjectName)\" />
        <Copy SourceFiles="YgoDuelist.json" DestinationFolder="$(Sts2Path)\mods\$(MSBuildProjectName)\" />
        <Message Text="Copying BaseLib to mods folder." Importance="high" />
        <ItemGroup>
            <BaseLibFiles Include="$(BaseLibPackageRoot)\lib\net9.0\BaseLib.dll;$(BaseLibPackageRoot)\Content\BaseLib.pck;$(BaseLibPackageRoot)\Content\BaseLib.json;" />
        </ItemGroup>
        <Copy SourceFiles="@(BaseLibFiles)" DestinationFolder="$(Sts2Path)\mods\BaseLib\" />
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish" Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="Exporting Godot .pck to mods folder" Importance="high" />
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(Sts2Path)\mods\$(MSBuildProjectName)\$(MSBuildProjectName).pck&quot;" EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1" ContinueOnError="WarnAndContinue" />
    </Target>

    <Target Name="GodotPublishSkipped" AfterTargets="Publish" Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')">
        <Message Text="Skipping Godot .pck export because GodotPath is not configured." Importance="high" />
    </Target>
</Project>
